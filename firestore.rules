rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - synchronized user profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Analytics & visitor logs
    match /analytics/{docId} {
      allow read, write: if true;
    }
    match /visitor_logs/{logId} {
      allow read, write: if true;
    }
    match /quiz_attempts/{attemptId} {
      allow read, write: if true;
    }
    match /user_activities/{activityId} {
      allow read, write: if true;
    }
    match /download_events/{downloadId} {
      allow read, write: if true;
    }
    match /exam_scores/{scoreId} {
      allow read, write: if true;
    }
    match /exam_submissions/{submissionId} {
      allow read, write: if true;
    }
  }
}
